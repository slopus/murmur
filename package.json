{
  "name": "murmur-server",
  "version": "1.0.0",
  "description": "Encrypted message transfer server with NaCl-based authentication",
  "repository": "https://github.com/slopus/murmur-server.git",
  "author": "Steve Korshakov <steve@korshakov.com>",
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit",
    "start": "tsx ./sources/main.ts",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "db": "docker run -d -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=murmur -v $(pwd)/.pgdata:/var/lib/postgresql/data -p 5438:5432 postgres"
  },
  "devDependencies": {
    "@fastify/cors": "^11.1.0",
    "@types/node": "^24.8.1",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^6.0.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "zod": "^4.1.12"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@paralleldrive/cuid2": "^3.1.0",
    "@prisma/client": "^6.17.1",
    "ioredis": "^5.8.2",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "prisma": "^6.17.1",
    "prisma-json-types-generator": "^3.6.2",
    "privacy-kit": "^0.0.23",
    "prom-client": "^15.1.3",
    "tsx": "^4.20.6",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  }
}
