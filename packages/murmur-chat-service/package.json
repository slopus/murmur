{
    "name": "@murmur/chat-service",
    "version": "0.1.0",
    "private": true,
    "description": "Durable generic chat and encrypted attachment service above Murmur groups",
    "license": "MIT",
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "package.json"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "check": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "test:browser": "esbuild sources/index.ts --bundle --platform=browser --format=esm --outfile=dist/browser-smoke.js"
    },
    "dependencies": {
        "@noble/ciphers": "^1.2.1",
        "@noble/hashes": "^1.7.1",
        "@slopus/murmur": "workspace:*"
    },
    "devDependencies": {
        "@murmur/relay": "workspace:*",
        "esbuild": "^0.28.1",
        "typescript": "^5.9.3",
        "vitest": "^3.2.7"
    },
    "engines": {
        "node": ">=20"
    }
}
