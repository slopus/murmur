{
    "name": "murmur-relay",
    "main": "sources/cloudflare/main.ts",
    "compatibility_date": "2025-04-01",
    "durable_objects": {
        "bindings": [
            {
                "name": "MURMUR_INBOXES",
                "class_name": "MurmurInboxV2DurableObject",
            },
            {
                "name": "MURMUR_FANOUT",
                "class_name": "MurmurFanoutV2DurableObject",
            },
        ],
    },
    // Cloudflare tracks applied migration tags per deployment, so historical
    // entries stay as a ledger even though their classes are gone from the code.
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["MurmurInboxDurableObject", "MurmurFanoutDurableObject"],
        },
        {
            "tag": "v2",
            "new_sqlite_classes": ["MurmurPrivateGroupDurableObject"],
        },
        {
            "tag": "v3",
            "deleted_classes": ["MurmurPrivateGroupDurableObject"],
        },
        {
            "tag": "v4",
            "new_sqlite_classes": ["MurmurInboxV2DurableObject", "MurmurFanoutV2DurableObject"],
        },
        {
            "tag": "v5",
            "deleted_classes": ["MurmurInboxDurableObject", "MurmurFanoutDurableObject"],
        },
    ],
    "vars": {
        "MURMUR_RELAY_ENDPOINT": "wss://murmur-relay.bulka-llc.workers.dev/v2/connect",
        "WORKOS_CLIENT_ID": "client_01KZD3XE9YAFAMT0P8TD4HP73E",
    },
}
