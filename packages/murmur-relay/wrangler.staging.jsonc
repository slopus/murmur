{
    "name": "murmur-relay-staging",
    "main": "sources/cloudflare/main.ts",
    "compatibility_date": "2025-04-01",
    "durable_objects": {
        "bindings": [
            {
                "name": "MURMUR_INBOXES",
                "class_name": "MurmurInboxDurableObject",
            },
            {
                "name": "MURMUR_FANOUT",
                "class_name": "MurmurFanoutDurableObject",
            },
        ],
    },
    // Cloudflare tracks applied migration tags per deployment, so historical
    // entries stay as a ledger even though their classes are gone from the code.
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["MurmurInboxDurableObject", "MurmurFanoutDurableObject"],
        },
        {
            "tag": "v2",
            "new_sqlite_classes": ["MurmurPrivateGroupDurableObject"],
        },
        {
            "tag": "v3",
            "deleted_classes": ["MurmurPrivateGroupDurableObject"],
        },
    ],
    "vars": {
        "MURMUR_RELAY_ENDPOINT": "wss://murmur-relay-staging.bulka-llc.workers.dev/v2/connect",
    },
}
