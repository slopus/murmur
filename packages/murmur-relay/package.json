{
    "name": "@murmur/relay",
    "version": "0.1.0",
    "private": true,
    "description": "Murmur Relay: encrypted topics with snapshot, list, and a bounded event log",
    "license": "MIT",
    "bin": {
        "murmur-relay": "./dist/main.js"
    },
    "files": [
        "dist",
        "README.md",
        "package.json"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "check": "tsc --noEmit -p tsconfig.json",
        "start": "node dist/main.js",
        "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
        "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest"
    },
    "dependencies": {
        "@noble/curves": "^1.8.1",
        "@noble/hashes": "^1.7.1",
        "pg": "^8.13.1"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.2.17",
        "@types/node": ">=22",
        "@types/pg": "^8.11.10",
        "typescript": "^5.9.3",
        "vitest": "^3.2.7"
    },
    "engines": {
        "node": ">=22.5.0"
    }
}
