{
    "name": "@slopus/murmur-relay",
    "version": "0.1.0",
    "private": true,
    "description": "Murmur Relay: authenticated encrypted identity queues",
    "license": "MIT",
    "bin": {
        "murmur-relay": "./dist/main.js"
    },
    "files": [
        "dist",
        "README.md",
        "package.json"
    ],
    "type": "module",
    "sideEffects": [
        "./dist/main.js"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "pnpm run clean && tsc -p tsconfig.build.json",
        "build:binary": "bun scripts/buildBinary.ts",
        "cloudflare:deploy:production": "wrangler deploy --config wrangler.production.jsonc",
        "cloudflare:deploy:staging": "wrangler deploy --config wrangler.staging.jsonc",
        "cloudflare:dev:production": "wrangler dev --config wrangler.production.jsonc",
        "cloudflare:dev:staging": "wrangler dev --config wrangler.staging.jsonc",
        "check": "tsc --noEmit -p tsconfig.json",
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "start": "node dist/main.js",
        "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
        "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest"
    },
    "dependencies": {
        "@noble/curves": "^1.8.1",
        "@noble/hashes": "^1.7.1",
        "pg": "^8.13.1",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.2.17",
        "@types/node": ">=22",
        "@types/pg": "^8.11.10",
        "typescript": "^5.9.3",
        "vitest": "^3.2.7"
    },
    "engines": {
        "node": ">=22.5.0"
    }
}
