{
    "name": "murmur-chat",
    "version": "0.1.8",
    "description": "Murmur CLI over transport-neutral encrypted relays and MLS",
    "license": "MIT",
    "author": "Steve",
    "bin": {
        "murmur": "./dist/main.js"
    },
    "files": [
        "dist",
        "package.json"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./cli": {
            "import": "./dist/cli/index.js"
        }
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
        "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
        "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest",
        "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx sources/main.ts",
        "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning node dist/main.js",
        "prepublishOnly": "$npm_execpath run build && $npm_execpath test"
    },
    "dependencies": {
        "@murmur/mls": "workspace:*",
        "@slopus/murmur": "workspace:*"
    },
    "devDependencies": {
        "@murmur/relay": "workspace:*",
        "@types/node": ">=20",
        "tsx": "^4.20.6",
        "typescript": "^5",
        "vitest": "^3.2.4"
    },
    "engines": {
        "node": ">=22.5.0"
    }
}
